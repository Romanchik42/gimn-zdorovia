-- ШАБЛОН, А НЕ МИГРАЦИЯ (GIMN-027).
--
-- Имя файла намеренно без номера и с расширением .template: скрипт
-- scripts/build-apply-all.mjs собирает только *.sql, поэтому этот файл
-- не попадёт ни в apply_all.sql, ни в случайный прогон.
--
-- КОГДА ПРИМЕНЯТЬ: за неделю до запуска платного тарифа, не раньше.
-- Раньше не имеет смысла: баллы некуда потратить, а обещание «начислим
-- к запуску» превратится в «начислили и они лежат».
--
-- ЧТО ДЕЛАЕТ: начисляет 1000 баллов каждому, кто зарегистрировался
-- до момента запуска — как благодарность за участие в тестировании.
--
-- ПЕРЕД ПРИМЕНЕНИЕМ ПРОВЕРИТЬ:
--   1. Миграция 0020 применена (таблицы user_points и points_history есть).
--   2. Решено, кому начислять: всем подряд или только тем, кто реально
--      занимался. Запрос ниже — «всем подряд»; условие на количество
--      тренировок дописывается в WHERE.
--   3. Прогон делается ОДИН раз. Повторный прогон начислит ещё по 1000:
--      защиты нет, потому что reference_id здесь не заполняется.
--
-- КАК ПРИМЕНИТЬ:
--   скопировать файл в supabase/migrations/00NN_tester_bonus.sql
--   и прогнать: node scripts/apply-migration.mjs supabase/migrations/00NN_tester_bonus.sql

BEGIN;

INSERT INTO user_points (user_id, points)
SELECT id, 1000 FROM users
ON CONFLICT (user_id)
DO UPDATE SET points = user_points.points + 1000, updated_at = now();

INSERT INTO points_history (user_id, amount, reason, reference_type)
SELECT id, 1000, 'Стартовый бонус тестера', 'bonus' FROM users;

COMMIT;

-- ПОСЛЕ ПРИМЕНЕНИЯ — разослать через бота:
--
--   «Спасибо, что были с нами в тестовом периоде. Начислили 1000 баллов —
--    их можно применить при выборе тарифа. Баланс и история: настройки,
--    раздел «Мои баллы».»
--
-- Рассылка делается отдельно: массовой отправки в боте пока нет,
-- её нужно будет написать.
