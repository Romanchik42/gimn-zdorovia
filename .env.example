# Шаблон переменных окружения (SPEC 3.9).
# Реальные значения — в secrets/.env локально и в Vercel Project Settings.
# Этот файл коммитится, значения в нём быть НЕ должно.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gimn_zdorovia_bot
TELEGRAM_WEBHOOK_SECRET=

# Приложение
NEXT_PUBLIC_APP_URL=https://gimn-zdorovia.vercel.app
NEXT_PUBLIC_AUTHOR_SITE_URL=https://ai-arhitektor.ru

# Админ (user_id Романа, заполняется после первой регистрации)
ADMIN_USER_ID=

# Куда слать отзывы, если в БД нет админа с привязанным Telegram (GIMN-011).
# Пусто — уведомления уходят только админам из таблицы users.
TELEGRAM_ADMIN_CHAT_ID=

# Cron защита
CRON_SECRET=

# ---------------------------------------------------------------------------
# Вход по коду и через соцсети (GIMN-029). Всё необязательное: не задано —
# канал просто не показывается на экране входа, приложение работает как было.
# Как получить ключи — README, раздел «Настройка мобильного входа».
# ---------------------------------------------------------------------------

# SMS.ru: один ключ api_id. Без него SMS-вход скрыт.
SMS_PROVIDER_KEY=
# Имя отправителя, если согласовано с оператором. Пусто — имя по умолчанию.
SMS_SENDER=

# Resend: ключ и подтверждённый адрес отправителя. Нужны ОБА.
EMAIL_PROVIDER_KEY=
EMAIL_FROM=

# OAuth. Пока пусто — кнопки не показываются (скелеты готовы).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
VK_APP_ID=
VK_APP_SECRET=
